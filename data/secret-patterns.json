{
  "version": 1,
  "patterns": [
    {"name": "npm access token", "regex": "\\bnpm_[A-Za-z0-9]{36}\\b", "severity": "high"},
    {"name": "SendGrid API key", "regex": "\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b", "severity": "high"},
    {"name": "DigitalOcean token", "regex": "\\bdo[opr]_v1_[a-f0-9]{64}\\b", "severity": "high"},
    {"name": "PyPI upload token", "regex": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}", "severity": "high"},
    {"name": "Shopify access token", "regex": "\\bshp(?:at|ss|ca|pa)_[a-f0-9]{32}\\b", "severity": "high"},
    {"name": "Twilio API key", "regex": "\\bSK[0-9a-f]{32}\\b", "severity": "medium"},
    {"name": "Mailgun API key", "regex": "\\bkey-[0-9a-zA-Z]{32}\\b", "severity": "medium"}
  ]
}
